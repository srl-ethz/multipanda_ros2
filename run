#!/usr/bin/env bash
set -e

# *********************************************************
# One-click development environment start-up
#   Developed by: Jon Skerlj
#   Last update: 04.02.2026
#   Tested using Ubuntu 22.04
# *********************************************************

# Setup Paths
REPO_PATH=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_PATH")

# ==============================================================================
# 1. Path and Identity Setup
# ==============================================================================
REPO_PATH=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_PATH")
IMAGE_NAME="build-env"
CONTAINER_NAME="multipanda-container"

# Detect Architecture
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)  TAG_ARCH="amd64" ;;
    aarch64) TAG_ARCH="arm64" ;;
    *)       TAG_ARCH="$ARCH" ;;
esac
IMAGE_TAG="${IMAGE_NAME}:${REPO_NAME}-${TAG_ARCH}"

# ==============================================================================
# 2. Hardware Support Checks
# ==============================================================================
check_nvidia_gpu() {
    command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1
}

check_gpu_support() {
    docker info 2>/dev/null | grep -q "nvidia"
}

# Auto-detect whether we can provide X11/Display to the container.
# If DISPLAY is set and xhost +local:docker succeeds, enable X11 mounts.
X11_AVAILABLE=false
if [ -n "$DISPLAY" ] && [ -d /tmp/.X11-unix ]; then
    # try to grant access; if it fails we treat the environment as headless
    if xhost +local:docker >/dev/null 2>&1; then
        X11_AVAILABLE=true
        echo "X11 display detected and xhost configured. Running with display support."
    else
        echo "DISPLAY set but xhost failed — falling back to headless mode."
    fi
else
    echo "No X11 display detected — running headless."
fi

# ==============================================================================
# 3. Dynamic Argument Construction (Using All Your Flags)
# ==============================================================================
# Workspace Path inside container
WS_SRC="/home/developer/multipanda_ws/src"

# GPU Configuration
WITH_GPU_CONFIG=()
if check_nvidia_gpu && check_gpu_support; then
    if [ "$X11_AVAILABLE" = true ]; then
        # With display: include display/graphics for OpenGL/RViz
        WITH_GPU_CONFIG+=(--gpus 'all,"capabilities=compute,utility,graphics,display"')
    else
        # Headless: compute/utility only
        WITH_GPU_CONFIG+=(--gpus 'all,"capabilities=compute,utility"')
    fi
    echo "GPU support detected."
else
    echo "No GPU support. Using CPU rendering."
fi

# Prepare envs / volumes depending on X11 availability
DOCKER_ENV=()
DOCKER_VOLUMES=()
if [ "$X11_AVAILABLE" = true ]; then
    DOCKER_ENV+=(--env "DISPLAY=$DISPLAY")
    DOCKER_VOLUMES+=(--volume "/tmp/.X11-unix:/tmp/.X11-unix:rw")
else
    # set offscreen Qt platform to reduce warnings for headless GUI apps (optional)
    DOCKER_ENV+=(--env "QT_QPA_PLATFORM=offscreen")
fi

# ==============================================================================
# 4. Container Execution
# ==============================================================================
if [ "$(docker ps -q -f name=$CONTAINER_NAME)" ]; then
    echo "$CONTAINER_NAME is already running."
else
    echo "Launching $CONTAINER_NAME..."
    
    docker run -d \
        --name "$CONTAINER_NAME" \
        --user "$(id -u):$(id -g)" \
        --network host \
        --ipc host \
        --pid host \
        --privileged \
        --tty \
        --interactive \
        "${DOCKER_ENV[@]}" \
        --env "USER=$(id -u)" \
        --env "ROS_DOMAIN_ID=1" \
        "${DOCKER_VOLUMES[@]}" \
        --volume "/dev:/dev" \
        --volume "$HOME:/host" \
        --volume "${REPO_PATH}:/home/developer/multipanda_ws/src/" \
        --ulimit rtprio=99 \
        --ulimit rttime=-1 \
        --ulimit memlock=-1 \
        --cap-add=sys_nice \
        "${WITH_GPU_CONFIG[@]}" \
        "$IMAGE_TAG"
fi

# Enter the container
echo "➡ Entering environment..."
docker exec -it --user developer "$CONTAINER_NAME" /bin/bash -c "source /home/developer/.bashrc && bash"